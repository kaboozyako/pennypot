# Foundry compiler output
out/
cache/

# Foundry broadcast logs: keep run-latest.json, drop per-run + local/dry-run noise.
# (Leading **/ so the patterns match the nested packages/contracts/broadcast/ path.)
**/broadcast/**/run-[0-9]*.json
**/broadcast/*/31337/
**/broadcast/**/dry-run/

# Node / webapp
node_modules/
dist/
build/
.next/
.turbo/
coverage/
tsconfig.tsbuildinfo
# Auto-generated by Next.js; its content differs between `next dev` and
# `next build`, so tracking it produces spurious diffs on every machine.
next-env.d.ts

# Env & secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log
.vscode/
.idea/

# Claude Code personal settings (the shared .claude/launch.json IS tracked)
.claude/settings.local.json
